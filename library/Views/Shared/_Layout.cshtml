
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyLibrary</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/library.styles.css" asp-append-version="true" />

    <style>
        .navbar {
            background: linear-gradient(135deg, #fce7ef, #f5d5e1) !important;
            border-bottom: 1px solid #e8b4c8 !important;
            padding: 14px 24px;
        }

        .navbar .navbar-brand {
            color: #782642 !important;
            font-family: Georgia, "Times New Roman", serif;
            font-size: 1.4rem;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        .navbar .navbar-collapse {
            justify-content: center;
        }

        .navbar .navbar-nav {
            gap: 10px;
            align-items: center;
        }

        .navbar .nav-link {
            color: #782642 !important;
            font-family: "Segoe UI", sans-serif;
            font-size: 0.95rem;
            font-weight: 600;
            letter-spacing: 0.3px;
            padding: 9px 20px !important;
            border-radius: 8px;
            transition: background-color 0.25s ease, color 0.25s ease;
        }

        .navbar .nav-link:hover {
            background-color: #edc0d1;
            color: #70203e !important;
        }

        .navbar .nav-link.active {
            background-color: #b83d67 !important;
            color: #ffffff !important;
            box-shadow: 0 2px 6px rgba(120, 38, 66, 0.18);
        }

        .navbar .nav-link.active:hover {
            background-color: #a8325b !important;
            color: #ffffff !important;
        }

        .navbar .nav-link:focus-visible {
            outline: 2px solid #a8325b;
            outline-offset: 3px;
        }

        @@media (max-width: 767.98px) {
            .navbar {
                padding: 10px 14px;
            }

            .navbar .navbar-nav {
                align-items: stretch;
                gap: 4px;
                padding-top: 10px;
            }

            .navbar .nav-link {
                text-align: center;
            }
        }
    </style>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light box-shadow mb-3">
            <div class="container-fluid">

                <a class="navbar-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    MyLibrary
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex"
                     id="mainNavbar">
                    <ul class="navbar-nav">

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Books" ? "active" : "")"
                               asp-controller="Books"
                               asp-action="Index">
                                Books
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Members" ? "active" : "")"
                               asp-controller="Members"
                               asp-action="Index">
                                Members
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Notes" ? "active" : "")"
                               asp-controller="Notes"
                               asp-action="Index">
                                Notes
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Privacy" ? "active" : "")"
                               asp-controller="Home"
                               asp-action="Privacy">
                                Privacy
                            </a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - MyLibrary -
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
