@model BorrowForm

@{
    ViewData["Title"] = "Borrow a Book";
}

<div class="members-page borrow-page">

    <div class="members-heading">
        <div class="members-heading-text">
            <span class="members-label">LIBRARY MANAGEMENT</span>
            <h1>Borrow a Book</h1>
            <p>Record a new book borrowing transaction.</p>
        </div>
    </div>

    <div class="borrow-form-card">

        <div class="borrow-form-header">
            <div class="borrow-form-icon">+</div>
            <div>
                <h2>Borrowing Details</h2>
                <p>Complete the information below to record a new loan.</p>
            </div>
        </div>

        <div class="borrow-form-content">

            <form asp-action="Borrow" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger borrow-validation-summary"></div>

                <div class="borrow-form-group">
                    <label asp-for="MemberId" class="form-label">Select Member</label>
                    <select asp-for="MemberId" asp-items="ViewBag.Members" class="form-select">
                        <option value="">(choose a member)</option>
                    </select>
                    <span asp-validation-for="MemberId" class="text-danger borrow-field-error"></span>
                </div>

                <div class="borrow-form-group">
                    <label asp-for="BookId" class="form-label">Select Book</label>
                    <select asp-for="BookId" asp-items="ViewBag.Books" class="form-select">
                        <option value="">(choose a book)</option>
                    </select>
                    <span asp-validation-for="BookId" class="text-danger borrow-field-error"></span>
                </div>

                <div class="borrow-form-group">
                    <label asp-for="DaysAllowed" class="form-label">Days Allowed</label>
                    <input asp-for="DaysAllowed" class="form-control" />
                    <span asp-validation-for="DaysAllowed" class="text-danger borrow-field-error"></span>
                </div>

                <div class="borrow-form-note">
                    Please review the selected member, book, and allowed borrowing period before submitting.
                </div>

                <div class="borrow-form-actions">
                    <button type="submit" class="members-add-btn">
                        + Borrow Book
                    </button>

                    <a asp-action="Index" class="members-cancel-btn">
                        Cancel
                    </a>
                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
