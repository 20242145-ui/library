
@model Book

@{
    ViewData["Title"] = "Delete a book";
}

<div class="delete-page">
    <div class="delete-card">

        <div class="delete-icon">!</div>

        <p class="delete-label">BOOK MANAGEMENT</p>

        <h1>Delete a book</h1>

        <p class="delete-message">
            Are you sure you want to delete this book?
        </p>

        <div class="delete-warning">
            This action cannot be undone. Please review the book details
            before confirming your decision.
        </div>

        <div class="delete-book-details">
            <div class="delete-detail">
                <span>Book ID</span>
                <strong>@Model.BookId</strong>
            </div>

            <div class="delete-detail">
                <span>Title</span>
                <strong>@Model.Title</strong>
            </div>

            <div class="delete-detail">
                <span>Category</span>
                <strong>@(Model.Category ?? "—")</strong>
            </div>

            <div class="delete-detail">
                <span>Price</span>
                <strong>@(Model.Price?.ToString("N2") ?? "—")</strong>
            </div>
        </div>

        <p class="delete-loan-note">
            <span>Note:</span> Any loans of this book are deleted with it.
        </p>

        <form asp-action="Delete"
              asp-route-id="@Model.BookId"
              method="post"
              class="delete-actions">

            <a asp-action="Index" class="delete-cancel-btn">
                Cancel
            </a>

            <button type="submit" class="delete-confirm-btn">
                Delete Book
            </button>
        </form>

    </div>
</div>
