
@model library.Models.Member

@{
    ViewData["Title"] = "Delete Member";
}

<h1>Delete Member</h1>

<h3>Are you sure you want to delete this member?</h3>

<hr />

<div>
    <dl class="row">
        <dt class="col-sm-3">Full Name</dt>
        <dd class="col-sm-9">@Model.FullName</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@(Model.Email ?? "—")</dd>

        <dt class="col-sm-3">Member Type</dt>
        <dd class="col-sm-9">@Model.MemberType</dd>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.MemberId" method="post">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
