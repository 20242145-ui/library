@{
    ViewData["Title"] = "Home";
}

<div class="home-hero">
    <p class="home-label">LIBRARY DATABASE MANAGEMENT SYSTEM</p>

    <h1>
        Welcome to
        <span>MyLibrary</span>
    </h1>

    <div class="home-divider"></div>

    <p class="home-tagline">
        An organized and efficient way to manage library records.
    </p>

    <p class="home-description">
        MyLibrary is a database management system designed to maintain
        and organize book and member information in one centralized system.
        It allows users to add, view, update, and delete records, helping
        keep library information accurate, accessible, and organized.
    </p>

    <div class="home-buttons">
        <a asp-controller="Books" asp-action="Index"
           class="btn home-btn-primary">
            Manage Books
        </a>

        <a asp-controller="Members" asp-action="Index"
           class="btn home-btn-outline">
            Manage Members
        </a>
    </div>

    <p class="home-footer-text">
        ORGANIZE <span>•</span> MANAGE <span>•</span> MAINTAIN
    </p>
</div>
