@model List<Book>
@using library.Models

@{
    ViewData["Title"] = "Books";
}

<div class="books-page">

    <div class="books-heading">
        <div class="books-heading-text">
            <span class="books-label">LIBRARY MANAGEMENT</span>
            <h1>Books Catalogue</h1>
            <p>Manage your collection of books in one place.</p>
        </div>

        <a asp-action="Create" class="books-add-btn">
            <span class="books-add-icon">+</span>
            Add a Book
        </a>
    </div>

    <div class="books-summary">
        <div class="books-summary-icon">B</div>
        <div>
            <span class="books-summary-label">Total Books</span>
            <h2>@Model.Count</h2>
        </div>
    </div>

    <div class="books-table-card">

        <div class="books-table-header">
            <div>
                <h2>Book Collection</h2>
                <p>View and manage your registered books.</p>
            </div>

            <span class="books-count-badge">
                @Model.Count @(Model.Count == 1 ? "book" : "books")
            </span>
        </div>

        <div class="books-table-wrapper">
            <table class="books-table">
                <thead>
                    <tr>
                        <th class="books-id-column">ID</th>
                        <th>Book Title</th>
                        <th>Category</th>
                        <th class="books-price-column">Price</th>
                        <th class="books-actions-column">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Count > 0)
                    {
                        @foreach (var book in Model)
                        {
                            <tr>
                                <td class="books-id-cell">
                                    #@book.BookId
                                </td>

                                <td class="books-title-cell">
                                    <span class="books-title-mark">B</span>
                                    <span>@book.Title</span>
                                </td>

                                <td>
                                    <span class="books-category-badge">
                                        @(string.IsNullOrWhiteSpace(book.Category)
                                            ? "Uncategorized"
                                            : book.Category)
                                    </span>
                                </td>

                                <td class="books-price-cell">
                                    @if (book.Price.HasValue)
                                    {
                                        <span>₱@book.Price.Value.ToString("N2")</span>
                                    }
                                    else
                                    {
                                        <span class="books-no-price">—</span>
                                    }
                                </td>

                                <td>
                                    <div class="books-actions">
                                        <a asp-action="Edit"
                                           asp-route-id="@book.BookId"
                                           class="books-edit-btn">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@book.BookId"
                                           class="books-delete-btn">
                                            Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="books-empty-state">
                                <div class="books-empty-icon">B</div>
                                <h3>No books yet</h3>
                                <p>Your collection is empty. Add your first book to get started.</p>
                                <a asp-action="Create" class="books-empty-btn">
                                    Add Your First Book
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="books-table-footer">
            Showing @Model.Count @(Model.Count == 1 ? "book" : "books") in your collection
        </div>

    </div>

</div>
